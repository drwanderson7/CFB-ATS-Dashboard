{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/parse_pdf.py": {
      "maxDuration": 30
    },
    "api/parse_pool.py": {
      "maxDuration": 30
    },
    "api/fetch_predictions.py": {
      "maxDuration": 20
    },
    "api/fetch_odds.py": {
      "maxDuration": 15
    },
    "api/state.py": {
      "maxDuration": 10
    },
    "api/grade_picks.py": {
      "maxDuration": 20
    },
    "api/fetch_cfbd.py": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/grade_picks",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
